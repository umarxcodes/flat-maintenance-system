{
  "name": "flat-maintenance-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "author": "Muhammad Umar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node --check src/app.js && node --check src/server.js && node --check src/config/db.config.js",
    "test": "node src/scripts/api-smoke-test.js",
    "test:smoke": "node src/scripts/api-smoke-test.js",
    "test:auth": "node --test --env-file=.env src/modules/auth/auth.test.js",
    "test:users": "node --test --env-file=.env src/modules/users/users.test.js",
    "test:roles": "node --test --env-file=.env src/modules/roles/roles.test.js",
    "test:permissions": "node --test --env-file=.env src/modules/permissions/permissions.test.js",
    "test:buildings": "node --test --env-file=.env src/modules/buildings/buildings.test.js",
    "test:blocks": "node --test --env-file=.env src/modules/blocks/blocks.test.js",
    "test:floors": "node --test --env-file=.env src/modules/floors/floors.test.js",
    "bootstrap:super-admin": "node src/scripts/bootstrap-super-admin.js",
    "seed:roles": "node src/scripts/seed-roles.js",
    "seed:permissions": "node src/scripts/seed-permissions.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "multer": "^2.1.1",
    "zod": "^4.5.4"
  }
}
